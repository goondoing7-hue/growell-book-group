{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/meeting/:bookId/:round", "destination": "/api/meeting-share?bookId=:bookId&round=:round" }
  ],
  "functions": {
    "api/meeting-share.js": {
      "includeFiles": "{server/meetingShareService.cjs,meetingRecordShare.js}"
    },
    "api/web-push.js": {
      "maxDuration": 60,
      "includeFiles": "{server/webPush*.cjs,server/driveBackupDomain.cjs,dailyVerseDomain.js,dailyVerses.js}"
    },
    "api/meeting-record-pdf.js": {
      "maxDuration": 60,
      "includeFiles": "{server/*.cjs,server/fonts/**,meetingRecordsDomain.js}"
    },
    "api/meeting-record-mail.js": {
      "maxDuration": 60,
      "includeFiles": "{server/*.cjs,server/fonts/**}"
    },
    "api/meeting-calendar.js": {
      "maxDuration": 60,
      "includeFiles": "{server/meetingCalendarDomain.cjs,server/meetingCalendarProvider.cjs,server/meetingCalendarService.cjs}"
    },
    "api/drive-backup.js": {
      "maxDuration": 60,
      "includeFiles": "{server/driveBackup*.cjs,server/googleConnectionService.cjs,server/meetingMailService.cjs,server/meetingCalendar*.cjs}"
    },
    "api/material-video-transcript.js": {
      "maxDuration": 60,
      "includeFiles": "{server/materialTranscriptService.cjs,server/materialTranscriptProvider.cjs,server/materialTranscriptTranslation.cjs,server/materialVideoMetadata.cjs,server/materialVideoService.cjs,server/materialVideoAI.cjs}"
    },
    "api/material-video-summary.js": {
      "maxDuration": 60,
      "includeFiles": "{server/materialVideoService.cjs,server/materialVideoAI.cjs,materialsMedia.js}"
    },
    "api/habit-sync.js": {
      "maxDuration": 60,
      "includeFiles": "{server/habitSyncDomain.cjs,server/habitSyncService.cjs,readingHabit.js,habitDomain.js}"
    }
  }
}
