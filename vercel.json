{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/meeting-record-mail.js": {
      "maxDuration": 60,
      "includeFiles": "{server/meetingMailService.cjs,server/meetingRecordPdf.cjs,server/fonts/**,server/driveBackupDomain.cjs,server/driveBackupService.cjs,server/driveBackupProvider.cjs,server/googleConnectionService.cjs,server/meetingCalendarDomain.cjs,server/meetingCalendarProvider.cjs,server/meetingCalendarService.cjs}"
    },
    "api/meeting-calendar.js": {
      "maxDuration": 60,
      "includeFiles": "{server/meetingCalendarDomain.cjs,server/meetingCalendarProvider.cjs,server/meetingCalendarService.cjs}"
    },
    "api/drive-backup.js": {
      "maxDuration": 60,
      "includeFiles": "{server/driveBackupDomain.cjs,server/driveBackupProvider.cjs,server/driveBackupService.cjs,server/googleConnectionService.cjs,server/meetingMailService.cjs,server/meetingCalendarDomain.cjs,server/meetingCalendarProvider.cjs,server/meetingCalendarService.cjs}"
    },
    "api/material-video-transcript.js": {
      "maxDuration": 60,
      "includeFiles": "{server/materialTranscriptService.cjs,server/materialTranscriptProvider.cjs,server/materialTranscriptTranslation.cjs,server/materialVideoMetadata.cjs,server/materialVideoService.cjs,server/materialVideoAI.cjs}"
    },
    "api/material-video-summary.js": {
      "maxDuration": 60,
      "includeFiles": "{server/materialVideoService.cjs,server/materialVideoAI.cjs,materialsMedia.js}"
    },
    "api/habit-sync.js": {
      "maxDuration": 60,
      "includeFiles": "{server/habitSyncDomain.cjs,server/habitSyncService.cjs,readingHabit.js,habitDomain.js}"
    }
  }
}
